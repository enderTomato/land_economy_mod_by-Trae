<!doctype html><html lang="zh-CN"><head><meta charset="UTF-8"/><link rel="icon" type="image/svg+xml" href="/vite.svg"/><meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no"/><title>123云盘</title><script>// 作用：域名重定向的js脚本
        (function () {
          // 配置常量
          var SOURCE_DOMAINS = ['123865.com', '123912.com', '123684.com', '123pan.com', '123pan.cn'];
          var UNVERIFIED_THIRD_LEVEL_DOMAINS = ['123865.com', '123912.com'];
          var VALID_TARGET_SUFFIXES = ['.123pan.cn', '.123pan.com', '.123684.com'];
          // 同会话锁死设备域名，避免手机「电脑版」下 viewport 抖动导致 share/mshare 死循环
          var SHARE_DEVICE_PREFIX_KEY = 'share_device_host_prefix';

          var config = window.__REDIRECT_CONFIG__ || {};
          var API_HOST = config.API_HOST || '';
          var API_PATH = config.API_PATH || '';

          // 优先用物理屏幕短边（不受「请求桌面版」影响），innerWidth 仅兜底
          function isMobileDevice() {
            try {
              var locked = sessionStorage.getItem(SHARE_DEVICE_PREFIX_KEY);
              if (locked === '.mshare.') return true;
              if (locked === '.share.') return false;
            } catch (e) { }

            var sw = window.screen ? Math.min(window.screen.width, window.screen.height) : 0;
            if (sw > 0) return sw <= 720;

            var iw = window.innerWidth || 0;
            var ih = window.innerHeight || 0;
            var innerMin = iw && ih ? Math.min(iw, ih) : 0;
            return innerMin > 0 && innerMin <= 720;
          }

          function getEnvPrefix(host) {
            var canaryMatch = host.match(/(^|\.)canary(-[^.]+)?\./i);
            if (canaryMatch) return 'canary' + (canaryMatch[2] || '');
            var devMatch = host.match(/(^|\.)dev(\d+)\./i);
            if (devMatch) return 'dev' + devMatch[2];
            return '';
          }

          function isLegacySourceDomain(host) {
            var escapedDomains = SOURCE_DOMAINS.map(function (d) { return d.replace(/\./g, '\\.'); }).join('|');
            var prefixPattern = '(www|dev\\d+|canary(?:-[a-z0-9]+)?)';
            var regex = new RegExp('^(' + prefixPattern + '\\.(' + escapedDomains + '))|(' + escapedDomains + ')$', 'i');

            // 排除 canary-a.123pan.com ⬅️预发环境的支付域名
            if (host === 'canary-a.123pan.com') {
              return false;
            }
            return regex.test(host);
          }

          function isUserOwnedDomain(host) {
            // 条件 1: 必须是分享三级域名（含 .mshare. 或 .share.）；非三级域名需走后续重定向逻辑
            var parts = host.split('.');
            var isThirdLevelShareDomain =
              (host.indexOf('.mshare.') !== -1 || host.indexOf('.share.') !== -1) && parts.length >= 3;
            if (!isThirdLevelShareDomain) return false;
            // 条件 2: 必须命中白名单后缀
            return VALID_TARGET_SUFFIXES.some(function (suffix) {
              return host.endsWith(suffix);
            });
          }

          function isUnverifiedThirdLevelDomain(host) {
            if (host.indexOf('.mshare.') === -1 && host.indexOf('.share.') === -1) {
              return false;
            }
            var escapedDomains = UNVERIFIED_THIRD_LEVEL_DOMAINS.map(function (d) { return d.replace(/\./g, '\\.'); }).join('|');
            var prefixPattern = '(www|dev\\d+|canary(?:-[a-z0-9]+)?)';
            var regex = new RegExp('^(' + prefixPattern + '\\.(' + escapedDomains + '))|(' + escapedDomains + ')$', 'i');
            return regex.test(host);
          }

          function buildIdealHostname(uid, envPrefix, isMobile) {
            var targetDevicePrefix = isMobile ? '.mshare.' : '.share.';
            var targetBaseDomain = '123pan.cn';
            return envPrefix
              ? uid + targetDevicePrefix + envPrefix + '.' + targetBaseDomain
              : uid + targetDevicePrefix + targetBaseDomain;
          }

          function stripHtmlFromPath(path) {
            return path.replace(/\/([^/]+)\.html(\/?$)/i, '/$1$2');
          }

          function normalizeSharePath(path) {
            var normalized;
            if (path.startsWith('/s/') || path.startsWith('/ps/')) {
              var prefixLen = path.startsWith('/s/') ? 3 : 4;
              var restPath = path.substring(prefixLen);
              normalized = restPath ? '/123pan/' + restPath : '/123pan';
            } else if (path === '/s' || path === '/ps') {
              normalized = '/123pan';
            } else {
              normalized = path;
            }
            return stripHtmlFromPath(normalized);
          }

          function getShareKey() {
            var rawParts = window.location.pathname.split('/');
            // rawParts[0] is "" for paths starting with /
            var key = '';

            if (rawParts.length >= 3 && (rawParts[1] === 's' || rawParts[1] === 'ps' || rawParts[1] === '123pan')) {
              key = rawParts[2];
            } else if (rawParts.length >= 2 && rawParts[1]) {
              key = rawParts[1];
            }
            return key ? key.replace(/\.html$/i, '') : '';
          }

          function getShareUidAsync() {
            var shareKey = getShareKey();
            if (!shareKey) {
              console.log('Redirect: 未找到 shareKey');
              return Promise.resolve(null);
            }
            var API_HOST = '';
            var API_PATH = '/gsb/s';
            var fetchUrl = API_HOST + API_PATH + '/share-key?shareKey=' + encodeURIComponent(shareKey);
            return fetch(fetchUrl)
              .then(function (res) {
                return res.json();
              })
              .then(function (result) {
                if (result.info && result.info.code === 0) {
                  return result.info.data.UserID;
                } else {
                  console.warn('Redirect: 未能从 API 获取有效的 UID');
                  return null;
                }
              })
              .catch(function (err) {
                console.error('Redirect: Fetch error:', err);
                return null;
              });
          }

          var host = window.location.hostname;
          var port = window.location.port ? ':' + window.location.port : '';
          var isMobile = isMobileDevice();
          try {
            sessionStorage.setItem(SHARE_DEVICE_PREFIX_KEY, isMobile ? '.mshare.' : '.share.');
          } catch (e) { }

          // 路径规范化
          var originalPath = window.location.pathname;
          var normalizedPath = normalizeSharePath(originalPath);

          // 1. 未实名三级域名（uid.share.123865.com / 123912.com 及 dev、canary 变体）重定向至 123pan.cn
          if (isUnverifiedThirdLevelDomain(host)) {
            var unverifiedUid = host.split('.')[0];
            var unverifiedEnvPrefix = getEnvPrefix(host);
            var unverifiedTargetUrl = 'https://' + buildIdealHostname(unverifiedUid, unverifiedEnvPrefix, isMobile)
              + port + normalizedPath + window.location.search + window.location.hash;
            console.log('Redirect: 检测到未实名三级域名, 正在重定向至', unverifiedTargetUrl);
            window.location.replace(unverifiedTargetUrl);
            return;
          }

          // 2. 判断当前是否已经是合法域名（三级域名 + 123pan.cn 判断）
          if (isUserOwnedDomain(host)) {
            // 检查设备类型是否匹配
            var currentIsMshare = host.includes('.mshare.');
            var currentIsShare = host.includes('.share.');
            var needRedirect = false;
            var correctedHost = host;
            if (!isMobile && currentIsMshare) {
              // PC 访问了 mshare -> 纠正为 share
              correctedHost = host.replace('.mshare.', '.share.');
              needRedirect = true;
            } else if (isMobile && currentIsShare) {
              // Mobile 访问了 share -> 纠正为 mshare
              correctedHost = host.replace('.share.', '.mshare.');
              needRedirect = true;
            }
            if (!needRedirect && originalPath !== normalizedPath) {
              needRedirect = true;
            }
            if (needRedirect) {
              var finalUrl = 'https://' + correctedHost + port + normalizedPath + window.location.search + window.location.hash;
              if (originalPath !== normalizedPath) {
                console.log('Redirect: 正在规范化路径，从', originalPath, '到', normalizedPath, '目标URL:', finalUrl);
              } else {
                console.log('Redirect: 正在修正设备类型为', correctedHost, finalUrl);
              }
              window.location.replace(finalUrl);
            } else {
              console.log('Redirect: 域名有效且设备类型匹配');
            }
            return;
          }

          // 3. 如果不是用户自有域名，检查是否是旧域名
          if (isLegacySourceDomain(host)) {
            getShareUidAsync().then(function (uid) {
              if (!uid) {
                console.warn('Redirect: UID 不存在');
                return;
              }
              var envPrefix = getEnvPrefix(host);
              var idealHostname = buildIdealHostname(uid, envPrefix, isMobile);
              var targetUrl = 'https://' + idealHostname + port + normalizedPath + window.location.search + window.location.hash;
              console.log('Redirect: 检测到旧域名, 正在重定向至', targetUrl);
              window.location.replace(targetUrl);
            });
            return;
          }
          console.log('Redirect: 无需重定向或为自定义域名');
        })();</script><script>(function () {
          var h = location.hostname;
          var p = location.port ? ':' + location.port : '';
          var SHARE_DEVICE_PREFIX_KEY = 'share_device_host_prefix';
          var targetPrefix = '';

          try {
            targetPrefix = sessionStorage.getItem(SHARE_DEVICE_PREFIX_KEY) || '';
          } catch (e) { }

          // 与上一段统一：已锁定则复用；否则按物理屏幕短边判断
          if (targetPrefix !== '.mshare.' && targetPrefix !== '.share.') {
            var sw = window.screen ? Math.min(window.screen.width, window.screen.height) : 0;
            if (sw > 0) {
              targetPrefix = sw <= 720 ? '.mshare.' : '.share.';
            } else {
              var iw = window.innerWidth || 0;
              var ih = window.innerHeight || 0;
              var innerMin = iw && ih ? Math.min(iw, ih) : 0;
              targetPrefix = innerMin > 0 && innerMin <= 720 ? '.mshare.' : '.share.';
            }
            try {
              sessionStorage.setItem(SHARE_DEVICE_PREFIX_KEY, targetPrefix);
            } catch (e2) { }
          }

          console.log('targetPrefix:', targetPrefix);
          // 如果当前已经是目标域名，则不执行跳转
          if (h.indexOf(targetPrefix) !== -1) return;

          // 将当前域名中的 .share. 或 .mshare. 替换为目标前缀
          var nh = h.replace(/\.mshare\./, '.share.').replace(/\.share\./, targetPrefix);
          console.log('new hostname:', nh);
          if (nh === h) return; // 防御性判断：如果没有发生替换，直接返回

          // 执行跳转
          location.replace(location.protocol + '//' + nh + p + location.pathname + location.search + location.hash);
        })();</script><script>/** 在 getLogin.js 执行前尽早缓存 pwd / token，避免 verify 跳转链中 href 丢失参数 */
        (function () {
          try {
            var params = new URLSearchParams(window.location.search);
            var pwd = params.get('pwd');
            if (pwd) {
              var segments = window.location.pathname.split('/').filter(Boolean);
              var shareKey = segments[segments.length - 1];
              if (shareKey && shareKey !== '123pan') {
                shareKey = shareKey.replace(/\.html$/i, '');
                localStorage.setItem('sharePwdd_' + shareKey, pwd);
              }
            }
            var token = params.get('token');
            if (token) {
              var remember = params.get('remember');
              if (remember === 'no') {
                localStorage.removeItem('authorToken');
                localStorage.removeItem('remember');
                sessionStorage.setItem('authorToken', JSON.stringify(token));
                sessionStorage.setItem('remember', JSON.stringify('no'));
              } else {
                sessionStorage.removeItem('authorToken');
                sessionStorage.removeItem('remember');
                localStorage.setItem('authorToken', JSON.stringify(token));
                localStorage.setItem('remember', JSON.stringify('yes'));
              }
            }
          } catch (e) { }
        })();</script><script defer="defer" src="https://statics.123pan.com/assets/js/runtime.fd9f2ecc.js"></script><script defer="defer" src="https://statics.123pan.com/assets/js/vendors.a2ea28bc.js"></script><script defer="defer" src="https://statics.123pan.com/assets/js/index.7089c5e4.js"></script><link href="https://statics.123pan.com/assets/css/vendors.5ad51727.css" rel="stylesheet"><link href="https://statics.123pan.com/assets/css/index.4def5dcd.css" rel="stylesheet"></head><body><div id="root"></div><script src="//at.alicdn.com/t/c/font_4856964_bv257w53bug.js" async></script><script id="cnzz-script">{
